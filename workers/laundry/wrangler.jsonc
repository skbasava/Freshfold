{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "laundry-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "LAUNDRY_DB",
      "database_name": "laundry-core",
      "database_id": "382ef6b2-19c9-47f3-a09f-3bf1dc7a227b",
      "migrations_dir": "../../migrations/laundry"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_REALTIME",
        "class_name": "TenantRealtime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantRealtime"]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "CALENDAR_QUEUE", "queue": "laundry-calendar-queue" },
      { "binding": "NOTIFY_QUEUE", "queue": "laundry-notify-queue" }
    ]
  },
  "vars": {
    "ENVIRONMENT": "development"
  }
}
