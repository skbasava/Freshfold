{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@freshfold/ui": ["./src/ui/index.ts"],
      "@freshfold/ui/*": ["./src/ui/*"],
      "@laundry/contracts": ["../packages/contracts/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts", "vite.config.ts"]
}
