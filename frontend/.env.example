# FreshFold Web Frontend Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings.

# URL of the Cloudflare Gateway Worker API (e.g. https://api.freshfold.example.com)
VITE_API_URL=http://127.0.0.1:8787

# Supabase Auth Configuration (for Google OAuth & staff access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar embed configuration (optional)
VITE_GOOGLE_CALENDAR_ID=
VITE_GOOGLE_CALENDAR_EMBED_URL=

