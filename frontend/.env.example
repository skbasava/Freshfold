# FreshFold Web Frontend Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings.

# Data Source Mode: 'live' (Cloudflare D1 & Workers) or 'mock' (in-memory demo store)
VITE_API_MODE=live

# URL of the Cloudflare Gateway Worker API (e.g. https://laundry-gateway.your-subdomain.workers.dev)
# For local dev: http://127.0.0.1:8787
# For Vercel production: https://<your-gateway-worker>.workers.dev
VITE_API_URL=http://127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787

# Enable demo fallbacks for unconfigured live endpoints (helpful during testing)
VITE_ENABLE_DEMO_FALLBACKS=true

# Supabase Auth Configuration (for Google OAuth & staff access)
# IMPORTANT: In Supabase Dashboard -> Authentication -> URL Configuration:
# 1. Update "Site URL" to your Vercel URL (e.g. https://your-app.vercel.app)
# 2. Add "Redirect URLs": https://*.vercel.app/** and http://localhost:5173/**
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar embed configuration (optional)
VITE_GOOGLE_CALENDAR_ID=
VITE_GOOGLE_CALENDAR_EMBED_URL=

# Frontend Logging Configuration
# Set VITE_ENABLE_LOGS=false to completely mute console logs
VITE_ENABLE_LOGS=true
# Stream frontend logs inline directly into the terminal running 'pnpm dev:web'
VITE_ENABLE_TERMINAL_LOGS=true
# Log level: debug | info | warn | error | silent
VITE_LOG_LEVEL=debug

