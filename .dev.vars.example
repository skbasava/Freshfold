ENVIRONMENT=development
INTERNAL_CONTEXT_SECRET=replace-with-at-least-32-characters
INTERNAL_CONTEXT_KEY_ID=v1
SERVICE_TOKEN=replace-with-at-least-32-characters
DLQ_ADMIN_TOKEN=replace-with-at-least-32-characters
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-me
GOOGLE_PRIVATE_KEY=replace-me
GOOGLE_CALENDAR_ID=replace-me
WHATSAPP_API_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
SMS_API_TOKEN=replace-me
SMS_API_URL=https://sms.example.invalid/messages
SMS_SENDER_ID=replace-me
# Supabase Auth server configuration (authn + JWT app_metadata/custom claim authz).
# Use a separate project per environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
SUPABASE_JWT_CLOCK_SKEW_SECONDS=60
SUPABASE_JWKS_CACHE_TTL_MS=300000
# Public anon key: safe for the browser, never used as server authorization.
SUPABASE_ANON_KEY=replace-with-public-anon-key
# Server-only and only if a separate administrative operation is approved.
# Never expose this value to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
