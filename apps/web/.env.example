# Public Supabase configuration only. Never put service-role or secret keys here.
# A service-role key is rejected at startup; only the project URL and anon key
# may be shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# OAuth callback & recovery redirects. Add both the origin `/login/callback`
# (for Google Sign-In) and `/reset-password` URL to the Supabase project's
# allowed redirect list. Use a different project and URL for local, staging and
# production; never reuse staging credentials in production.
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173/reset-password

# API mode. Mock mode does not require Supabase unless the two public Supabase
# values above are explicitly configured. Live mode sends the Supabase access
# token as a bearer credential to the Gateway /api/* routes.
VITE_API_MODE=mock
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000
VITE_REQUIRE_AUTH=false
VITE_ENABLE_DEMO_FALLBACKS=false
