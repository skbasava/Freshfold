{
  "name": "laundry-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p frontend/tsconfig.json && tsc -p workers/api/tsconfig.json",
    "typecheck:web": "tsc -p frontend/tsconfig.json",
    "typecheck:api": "tsc -p workers/api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "pnpm --filter @laundry/frontend test",
    "build:web": "pnpm --filter @laundry/frontend build",
    "dev:web": "pnpm --filter @laundry/frontend dev",
    "dev:api": "pnpm --filter @laundry/api dev",
    "db:generate": "pnpm --filter @laundry/api db:generate",
    "db:migrate:local": "pnpm --filter @laundry/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @laundry/api db:migrate:remote",
    "db:seed:local": "node scripts/seed-local-db.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:web && pnpm build:web"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "workerd": "1.20261110.1",
    "wrangler": "4.160.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
